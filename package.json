{
  "name": "freef1-web",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json --noEmit",
    "build": "npm run typecheck && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "replays": "node scripts/fetch-replays.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
